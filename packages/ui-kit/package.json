{
  "name": "@ai-shop/ui-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Angular design system, components, and design tokens for the AI Shop Salesman frontend",
  "license": "UNLICENSED",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "scripts": {
    "build": "ng-packagr -p ng-package.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit",
    "verify": "npm run build && npm run smoke && npm run typecheck"
  },
  "peerDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "rxjs": "^6.5.3 || ^7.4.0"
  },
  "devDependencies": {
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/compiler-cli": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "ng-packagr": "22.2.6",
    "rxjs": "7.8.2",
    "tslib": "2.9.1",
    "typescript": "~6.0.3"
  }
}
